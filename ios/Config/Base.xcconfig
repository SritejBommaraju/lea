// Shared build settings for RepairOS. Per-developer signing lives in Signing.xcconfig (gitignored);
// copy Signing.example.xcconfig to Signing.xcconfig and set your team.
PRODUCT_BUNDLE_IDENTIFIER_BASE = com.rohankilaru.repairos
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_BASE)
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
CLANG_CXX_LANGUAGE_STANDARD = c++17
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_C_LANGUAGE_STANDARD = gnu17
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
ALWAYS_SEARCH_USER_PATHS = NO

#include? "Signing.xcconfig"
