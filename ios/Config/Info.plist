<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>lea</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lea listens when you hold the mic, turn on hands-free or say Hey Leah, so you can talk through the repair.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lea turns what you say into text on this iPhone so it can answer you.</string>
	<key>NSCameraUsageDescription</key>
	<string>RepairOS uses the camera (and LiDAR when the phone has it) to scan the object and take close-up photos for the report.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RepairOS sends your scan to the RepairOS gateway on your local network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>arkit</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
