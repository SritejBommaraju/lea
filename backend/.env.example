# Backend settings. Copy to backend/.env (gitignored) and fill in the keys. Never commit values; the phone never
# holds a key (A6). `python3 -I build/doctor.py` says which ones the open tasks need.

# =============================================================================
# MINIMUM REQUIRED TO RUN THE DEMO
# =============================================================================
# These three keys are required for the core pipeline to work:

# --- Jev / TypeSafe (FUSION=jev; human step jev_key)
# TypeSafe console key - REQUIRED for fusion/verdict logic, no fallback
TYPESAFE_KEY=

# --- Claude (VLM=anthropic, LLM=anthropic; human step anthropic_key)
# Anthropic key - REQUIRED for vision inspection and report generation
ANTHROPIC_API_KEY=

# --- Runtime
# The pairing code the phone uses to connect - REQUIRED for app pairing
# Pick any long random string (e.g., openssl rand -hex 32)
REPAIROS_PAIRING_CODE=

# =============================================================================
# OPTIONAL: ENHANCED FEATURES
# =============================================================================
# These are optional and have graceful fallbacks when not set:

# --- Voice (optional; empty = the phone's own voice and speech recognition)
# Cartesia API key for server-side voice synthesis and recognition
# If empty: phone uses its built-in voice and Apple's speech recognition
CARTESIA_API_KEY=
# Optional voice overrides: CARTESIA_VOICE_ID, CARTESIA_TTS_MODEL (sonic-3.6), CARTESIA_STT_MODEL (ink-whisper),
# LEA_VOICE_ANSWER_MODEL (claude-haiku-5-5), LEA_VOICE_ANSWER_EFFORT (low)
# LEA_VOICE_LOOK_MODEL (claude-haiku-5-5: looking turns, eval/live_vision/RESULTS.md), LEA_VOICE_LOOK_TURNS_PER_SCAN (40)

# --- Reference hints (optional; empty = off)
# Bright Data SERP API for web search hints about objects
# If empty: inspection runs without web hints (detection still works)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# =============================================================================
# ADVANCED: DEVELOPMENT SETTINGS
# =============================================================================
# 1 = release build: refuses dev-only providers and REPAIROS_SLOT_* overrides
REPAIROS_RELEASE=
# Override default config/providers.yaml
REPAIROS_PROVIDERS_PATH=
# REPAIROS_PROFILE and REPAIROS_SLOT_<SLOT>=<impl> are read from the shell environment.
