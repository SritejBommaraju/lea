# RepairOS backend settings. Copy to backend/.env (gitignored) and fill in what your profile needs.
# Never commit values; never put a key on the phone (A6). `python3 -I build/doctor.py` says which ones you need.

# --- Grain (GRAIN=live): the owner runs Grain and creates the key (B0.10, human step grain_key / grain_project)
# Grain base URL (LAN or tunnel), e.g. http://host:8000
GRAIN_URL=
# Grain API key for the RepairOS backend
GRAIN_KEY=
# the demo product's Grain project id
GRAIN_TEST_PROJECT=
# pinned Grain interface version once Grain reports one (T10); empty until then
GRAIN_INTERFACE_VERSION=

# --- Jev / TypeSafe (FUSION=jev, both profiles; human step jev_key)
# TypeSafe console key
TYPESAFE_KEY=

# --- LLM / VLM (LLM=anthropic, VLM=anthropic; human step anthropic_key)
# Anthropic key, backend only
ANTHROPIC_API_KEY=
# LLM=openai or VLM=openai only
OPENAI_API_KEY=
# LLM=openai_compatible or VLM=qwen3vl: http://host:port/v1
OPENAI_COMPATIBLE_URL=
# optional key for that server
OPENAI_COMPATIBLE_KEY=

# --- SpacetimeDB (STATE=spacetimedb, full profile only)
# e.g. http://localhost:3000
SPACETIMEDB_URL=
# database name
SPACETIMEDB_DB=
# the backend's identity token (M.STATE.6); never given to the phone
SPACETIMEDB_SERVICE_TOKEN=

# --- Training / hosting (full profile only)
# TRAIN=runpod
RUNPOD_API_KEY=
# TRAIN=lambda
LAMBDA_API_KEY=
# HOST=docker_gpu: user@host of the GPU box
HOST_SSH=

# --- Blob store (BLOB=s3 only)
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Supplier search (SUPPLIER=nexar / digikey only)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# --- RepairOS runtime
# the code the phone types to pair with this backend (S2.1); pick any long random string
REPAIROS_PAIRING_CODE=
# 1 = release build: refuses dev-only providers and REPAIROS_SLOT_* overrides
REPAIROS_RELEASE=
# default config/providers.yaml
REPAIROS_PROVIDERS_PATH=
# REPAIROS_PROFILE and REPAIROS_SLOT_<SLOT>=<impl> are read from the shell environment (as build/doctor.py does).
