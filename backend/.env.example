# Backend settings. Copy to backend/.env (gitignored) and fill in the keys. Never commit values; the phone never
# holds a key (A6). `python3 -I build/doctor.py` says which ones the open tasks need.

# --- Jev / TypeSafe (FUSION=jev; human step jev_key)
# TypeSafe console key
TYPESAFE_KEY=

# --- Claude (VLM=anthropic, LLM=anthropic; human step anthropic_key)
# Anthropic key, backend only
ANTHROPIC_API_KEY=

# --- Voice (optional; the phone falls back to on-device speech without it)
# Cartesia key, backend only
CARTESIA_API_KEY=
# Cartesia voice id for spoken replies (default: Cartesia's quickstart voice)
CARTESIA_VOICE_ID=
# Cartesia API version (default 2026-08-14)
CARTESIA_VERSION=

# --- Grain (Phase 2 only; Phase 1 makes no Grain calls)
# Grain base URL, e.g. http://host:8000
GRAIN_URL=
# Grain API key for the backend
GRAIN_KEY=
# the Grain project id of the product under test
GRAIN_TEST_PROJECT=
# pinned Grain interface version once Grain reports one; empty until then
GRAIN_INTERFACE_VERSION=

# --- Runtime
# the code the phone types to pair with this backend; pick any long random string
REPAIROS_PAIRING_CODE=
# 1 = release build: refuses dev-only providers and REPAIROS_SLOT_* overrides
REPAIROS_RELEASE=
# default config/providers.yaml
REPAIROS_PROVIDERS_PATH=
# REPAIROS_PROFILE and REPAIROS_SLOT_<SLOT>=<impl> are read from the shell environment.
