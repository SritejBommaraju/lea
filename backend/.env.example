# Backend settings. Copy to backend/.env (gitignored) and fill in the keys. Never commit values; the phone never
# holds a key (A6). `python3 -I build/doctor.py` says which ones the open tasks need.

# ============================================================================
# REQUIRED: Minimum to run the backend demo and get a report
# ============================================================================

# --- Anthropic Claude (REQUIRED for vision model, LLM, and report generation)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- TypeSafe/Jev (REQUIRED for evidence fusion; no fallback)
# Get your key from the TypeSafe console
TYPESAFE_KEY=

# --- Pairing code (REQUIRED for app to connect)
# Pick any long random string (e.g., openssl rand -hex 32)
REPAIROS_PAIRING_CODE=

# ============================================================================
# OPTIONAL: Enhanced features
# ============================================================================

# --- Voice (optional; without this, the phone uses its own voice and speech recognition)
# Get your API key from https://cartesia.ai/
CARTESIA_API_KEY=
# optional overrides: CARTESIA_VOICE_ID, CARTESIA_TTS_MODEL (sonic-3.6), CARTESIA_STT_MODEL (ink-whisper),
# LEA_VOICE_ANSWER_MODEL (claude-haiku-5-5), LEA_VOICE_ANSWER_EFFORT (low)
# LEA_VOICE_LOOK_MODEL (claude-haiku-5-5: looking turns, eval/live_vision/RESULTS.md), LEA_VOICE_LOOK_TURNS_PER_SCAN (40)

# --- Reference hints (optional; empty = disabled)
# Bright Data SERP API for web search hints
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# ============================================================================
# ADVANCED: Runtime configuration
# ============================================================================

# 1 = release build: refuses dev-only providers and REPAIROS_SLOT_* overrides
REPAIROS_RELEASE=
# default config/providers.yaml
REPAIROS_PROVIDERS_PATH=
# REPAIROS_PROFILE and REPAIROS_SLOT_<SLOT>=<impl> are read from the shell environment.
