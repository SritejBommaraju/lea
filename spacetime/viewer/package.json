{
  "name": "lea-live-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "The big-screen page: one scan, live from SpacetimeDB.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node serve.mjs",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../module",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "spacetimedb": "2.13.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "~5.6.2"
  }
}
